{
  "name": "eutopia.ts",
  "version": "0.2.0",
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npm run clean && tsc --project tsconfig.json && npm run copy:assets",
    "clean": "rm -rf dist",
    "copy:assets": "cpy '**/*.wgsl' '../dist' --cwd=src",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "check": "vp check",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "wgpu-matrix": "^3.4.2"
  },
  "devDependencies": {
    "@gribbet/vite-config": "^1.0.0",
    "@webgpu/types": "^0.1.74",
    "cpy-cli": "^7.0.0",
    "typescript": "^7.0.2",
    "vite-plus": "^1.0.0"
  },
  "peerDependencies": {
    "signaloits": "^2.0.3"
  }
}
